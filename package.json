{
  "name": "mosaic-memory-compress",
  "version": "1.0.0",
  "description": "Stateless dialogue compression that mimics human memory — forgetting-curve bounded context for LLM conversations. DeepSeek Harness (DSH) plugin backend included.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src/",
    "docs/"
  ],
  "scripts": {
    "test": "npx tsx tests/index.test.ts",
    "bench": "tsx benchmark/simulate.ts",
    "bench:real": "tsx benchmark/real-llm-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llm",
    "context-compression",
    "context-window",
    "memory",
    "conversation",
    "dialogue",
    "forgetting-curve",
    "agent-memory",
    "deepseek",
    "deepseek-harness",
    "ai-agents",
    "token-efficiency",
    "compression",
    "chatbot"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TuringCorp-net/mosaic-memory-compress"
  },
  "homepage": "https://github.com/TuringCorp-net/mosaic-memory-compress#readme"
}