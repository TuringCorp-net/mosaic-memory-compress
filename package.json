{
  "name": "mosaic-memory-compress",
  "version": "1.3.4",
  "description": "Generic stateless dialogue compression that mimics human memory — forgetting-curve bounded context for LLM conversations, with a ready-to-use adapter module for DeepSeek Harness (DSH).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dsh-module/dist/index.cjs": {
      "types": "./dsh-module/dist/index.d.cts",
      "default": "./dsh-module/dist/index.cjs"
    },
    "./dsh-module/dist/index.js": {
      "types": "./dsh-module/dist/index.d.ts",
      "default": "./dsh-module/dist/index.js"
    }
  },
  "files": [
    "src/",
    "dist/",
    "docs/",
    "scripts/",
    "dsh-module/dist/",
    "dsh-module/src/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "npx tsx tests/index.test.ts",
    "bench": "tsx benchmark/simulate.ts",
    "bench:real": "tsx benchmark/real-llm-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "llm",
    "context-compression",
    "context-window",
    "memory",
    "conversation",
    "dialogue",
    "forgetting-curve",
    "agent-memory",
    "deepseek",
    "deepseek-harness",
    "ai-agents",
    "token-efficiency",
    "compression",
    "chatbot"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TuringCorp-net/mosaic-memory-compress"
  },
  "homepage": "https://github.com/TuringCorp-net/mosaic-memory-compress#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
